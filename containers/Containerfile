FROM docker.io/library/ubuntu:24.04 AS base
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv openjdk-21-jre-headless ca-certificates \
    libstdc++6 libgcc-s1 libatomic1 \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/opt/app/.venv/bin:/usr/local/bin:/usr/bin:/bin" \
    CIV_AGENT_CONTAINER=1 HOME=/tmp/home
WORKDIR /opt/app
ENTRYPOINT ["/opt/app/.venv/bin/python", "-m", "civ_agent.container_runtime"]

FROM base AS desktop-base
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-21-jre xvfb x11vnc novnc websockify libgl1-mesa-dri libglx-mesa0 libgl1 \
    libx11-6 libxcursor1 libxrandr2 libxi6 libxinerama1 libxxf86vm1 \
    libopenal1 fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
ENV LIBGL_ALWAYS_SOFTWARE=1 ALSOFT_DRIVERS=null

FROM base AS runtime
COPY uv /usr/local/bin/uv
COPY app /opt/app
RUN uv sync --locked --no-dev --no-cache --python /usr/bin/python3
RUN /opt/app/.venv/bin/python -m civ_agent.monty_runtime
COPY lib /opt/unciv/lib
COPY engine /opt/unciv/engine
COPY provenance.json /opt/unciv/provenance.json
# The CLI's private umask also applies to staging directories and provenance.
# These curated image files contain only code/assets and must be readable by
# the caller's non-root UID when running with --userns=keep-id.
RUN chmod -R a+rX /opt/app /opt/unciv \
    && chmod 755 /usr/local/bin/uv

FROM desktop-base AS desktop
COPY --from=runtime /opt/app /opt/app
COPY --from=runtime /opt/unciv /opt/unciv
