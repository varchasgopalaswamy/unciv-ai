{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["epoch", "revision"],
  "properties": {
    "epoch": {"type": "string", "minLength": 1, "maxLength": 128},
    "revision": {"type": "string", "minLength": 1, "maxLength": 128},
    "cities": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string"}},
    "units": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string"}}
  }
}
