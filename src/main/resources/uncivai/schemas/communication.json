  "$defs": {
    "epoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "waitSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 25
    },
    "cursor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[ -~]+$"
    },
    "partner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "proposal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "job": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "purpose": {
      "enum": [
        "gameplay",
        "communication"
      ]
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "cached_input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "reasoning_output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "to": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "\\S"
      },
      "maxItems": 100,
      "uniqueItems": true
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "\\S"
      },
      "maxItems": 100,
      "uniqueItems": true,
      "minItems": 2
    },
    "terms": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "conditions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "expiresTurn": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "kind": {
      "enum": [
        "peace",
        "other"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "\\S"
      },
      "maxItems": 100,
      "uniqueItems": true
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    },
    "give": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Embassy",
              "Gold",
              "Gold_Per_Turn",
              "Treaty",
              "Agreement",
              "Luxury_Resource",
              "Strategic_Resource",
              "Stockpiled_Resource",
              "Technology",
              "Introduction",
              "WarDeclaration",
              "PeaceProposal",
              "City"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "duration": {
            "type": "integer",
            "minimum": -1,
            "maximum": 2147483647
          }
        },
        "required": [
          "type",
          "name",
          "amount",
          "duration"
        ],
        "additionalProperties": false
      },
      "maxItems": 64
    },
    "receive": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Embassy",
              "Gold",
              "Gold_Per_Turn",
              "Treaty",
              "Agreement",
              "Luxury_Resource",
              "Strategic_Resource",
              "Stockpiled_Resource",
              "Technology",
              "Introduction",
              "WarDeclaration",
              "PeaceProposal",
              "City"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "duration": {
            "type": "integer",
            "minimum": -1,
            "maximum": 2147483647
          }
        },
        "required": [
          "type",
          "name",
          "amount",
          "duration"
        ],
        "additionalProperties": false
      },
      "maxItems": 64
    },
    "decision": {
      "enum": [
        "accept",
        "decline",
        "withdraw"
      ]
    },
    "nativeAction": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "DENOUNCE",
            "ISSUE_DEMAND",
            "RESPOND_DIPLOMACY"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "selection": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "kind",
        "target",
        "revision"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "DENOUNCE"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "selection"
              ]
            }
          },
          "else": {
            "required": [
              "selection"
            ]
          }
        }
      ]
    },
    "apiCounts": {
      "type": "object",
      "properties": {
        "calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "succeeded": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "errors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "replayed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "incomplete": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "elapsedMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "calls",
        "succeeded",
        "errors",
        "replayed",
        "incomplete",
        "elapsedMs"
      ],
      "additionalProperties": false
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "startedAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "elapsedMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "negotiationWaitMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "gameplayElapsedMs": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "finalizationElapsedMs": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "endedAtMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "phase": {
          "enum": [
            "STARTING",
            "RUNNING",
            "COMPLETED",
            "INTERRUPTED",
            "FAILED"
          ]
        },
        "usageReported": {
          "type": "boolean"
        },
        "usageComplete": {
          "type": "boolean"
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "reasoningEffort": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "apiCalls": {
          "type": "object",
          "maxProperties": 512,
          "propertyNames": {
            "maxLength": 160
          },
          "additionalProperties": {
            "$ref": "#/$defs/apiCounts"
          }
        }
      },
      "required": [
        "sequence",
        "startedAtMs",
        "elapsedMs",
        "negotiationWaitMs",
        "endedAtMs",
        "phase",
        "usageReported",
        "usageComplete",
        "model",
        "reasoningEffort",
        "apiCalls"
      ],
      "additionalProperties": false
    }
  }
}
