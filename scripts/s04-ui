#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
version="${1:-after}"
scenario="${2:-blocked-placement}"
case "$version" in
    before|after) ;;
    *) echo "Usage: $0 [before|after] [blocked-placement|ordinary|ordinary-vanilla|maya|no-city|empty-maya-pool]" >&2; exit 2 ;;
esac
case "$scenario" in
    blocked-placement|ordinary|ordinary-vanilla|maya|no-city|empty-maya-pool) ;;
    *) echo "Unknown scenario: $scenario" >&2; exit 2 ;;
esac

cd -- "$repo_dir"
engine_dir="$repo_dir/vendor/Unciv"
if [[ "$version" == before ]]; then
    before_revision=d77a312ed6ba0d127fe4efdfbcdc9f4918c0b5fa
    engine_dir="$repo_dir/build/s04-ui/before-engine"
    if [[ ! -e "$engine_dir" ]]; then
        mkdir -p -- "$repo_dir/build/s04-ui"
        git clone --shared --no-checkout -- "$repo_dir/vendor/Unciv" "$engine_dir"
        git -C "$engine_dir" switch --detach "$before_revision"
    fi
    if [[ "$(git -C "$engine_dir" rev-parse HEAD)" != "$before_revision" ]] ||
       [[ -n "$(git -C "$engine_dir" status --porcelain)" ]]; then
        echo "The before-engine checkout must be clean at $before_revision; inspect $engine_dir." >&2
        exit 1
    fi
fi

exec ./gradlew --no-daemon --console=plain \
    "-PuncivDir=$engine_dir" "-PuiVersion=$version" "-PuiCase=$scenario" runS04Ui
